{
  "name": "agent-cafe",
  "version": "0.1.0",
  "description": "A pixel-art café where you watch your Claude Code and Codex agents work, in your browser.",
  "type": "module",
  "bin": { "agent-cafe": "dist/cli.mjs" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/JesusVelaz/agent-cafe.git" },
  "keywords": ["claude-code", "codex", "agents", "pixel-art"],
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/cli.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.6",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agent-cafe/server": "workspace:*",
    "@agent-cafe/web": "workspace:*",
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
