// Agent Café persistence. SQLite via Prisma 7 driver adapter (better-sqlite3).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Per-provider settings. No credentials: live runs use the harness the user signed in to.
model ProviderConfig {
  id        String   @id // 'openai' | 'anthropic'
  mode      String   @default("mock") // live | mock | off
  updatedAt DateTime @updatedAt
  // Legacy (API-key era), unused. Kept until the owner OKs dropping them.
  encryptedKey String?
  keyHint      String?
  dailyCapUsd  Float    @default(5)
}

model Agent {
  id           String    @id @default(cuid())
  name         String
  providerId   String
  model        String
  systemPrompt String
  spriteSeed   Int
  workDir      String? // legacy (per-agent folder), superseded by projects
  projectId    String? // project used last (composer default)
  permission   String    @default("ask") // ask | acceptEdits, used last
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?
  tasks        Task[]
}

model Task {
  id           String      @id @default(cuid())
  agent        Agent       @relation(fields: [agentId], references: [id])
  agentId      String
  providerId   String
  model        String
  prompt       String
  status       String      @default("queued")
  isMock       Boolean     @default(false)
  maxCostUsd   Float
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  costUsd      Float?
  steps        Int         @default(0)
  output       String?
  error        String?
  failureKind  String?
  retryOf      String?
  pendingApproval String? // JSON ApprovalDTO while the harness waits on the user
  projectId    String?
  permission   String      @default("ask")
  continueOf   String? // task whose conversation this continues
  sessionId    String? // harness session id (resumable)
  createdAt    DateTime    @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  events       TaskEvent[]

  @@index([agentId, status])
  @@index([status])
  @@index([createdAt])
}

model TaskEvent {
  id      Int      @id @default(autoincrement())
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId  String
  seq     Int
  kind    String
  payload String // JSON of TaskEventData
  at      DateTime @default(now())

  @@unique([taskId, seq])
}

/// Backs the notes_read / notes_write tools: a tiny shared memory for agents.
model Note {
  key       String   @id
  content   String
  updatedAt DateTime @updatedAt
}

/// App-wide key/value settings (e.g. ambient mode).
model Setting {
  key   String @id
  value String
}

/// A folder agents can work in, added once and picked by name.
model Project {
  id        String   @id @default(cuid())
  name      String
  path      String   @unique
  createdAt DateTime @default(now())
}
