{
  "name": "@agent-cafe/server",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": { "./main": "./src/main.ts", "./network": "./src/network.ts", "./token": "./src/token.ts" },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:reset": "prisma migrate reset --force && tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "@agent-cafe/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.6",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
