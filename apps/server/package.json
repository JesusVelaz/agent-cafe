{
  "name": "@agent-cafe/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "predev": "prisma db push",
    "db:push": "prisma db push",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:reset": "prisma db push --force-reset && tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "@agent-cafe/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
