# Agents Café server configuration. Copy to .env (repo root) if you need to change anything.
# There are no API keys: live floors run on Claude Code / Codex signed in with your own
# subscription (`claude auth login`, `codex login`).

# Folder the demo runs' read_file / list_files tools may read. Defaults to ./workspace
WORKSPACE_DIR=

CAFE_API_PORT=4318

# Set to 1 for a showcase café: idle Demo agents pick up sample tasks by themselves.
CAFE_DEMO_TRAFFIC=
