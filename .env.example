# Agent Café server configuration. Copy to .env (repo root) and fill in as needed.
# Keys set here take precedence over keys entered in the Settings page.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Folder the read_file / list_files tools may read (read-only sandbox). Defaults to ./workspace
WORKSPACE_DIR=

# Where the encryption master key lives. Defaults to ~/.agent-cafe
AGENT_CAFE_HOME=

CAFE_API_PORT=4318
